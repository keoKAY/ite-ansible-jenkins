pipeline{
    agent any 
    environment{
        GIT_URL="https://github.com/keoKAY/reactjs-devop8-template"
        IMG_NAME="ansible-react"
        VERSION="v1.0.${env.BUILD_NUMBER}"
        FULL_IMG="${IMG_NAME}:${VERSION}"
        DOCKERFILE="prod.Dockerfile"
    }
    stages{
        stage("Git Checkout"){
            steps{
            dir('application'){
                git "${GIT_URL}"
            }
              
            }
        }
        stage("Build Image"){
            steps{
                sh """
                cd application &&  docker build -t ${FULL_IMG} -f ${DOCKERFILE} . 
                """
            }
        }
        stage("Dockerhub"){
            steps{
            withCredentials([usernamePassword(credentialsId: 'DH_STAG',
             passwordVariable: 'PASS',
              usernameVariable: 'USER')]) {
                sh """
                    docker login -u ${USER} -p ${PASS} 
                    docker tag ${FULL_IMG} ${USER}/${FULL_IMG}
                    docker push ${USER}/${FULL_IMG} 
                """
            }
            }
        } 

        stage("ANSIBLE-Deploy"){
            steps{
                // for username , use from credential for more secured approach !
                dir('ansible'){
                    sh """
                    ansible-playbook playbooks/reactjs-main.yaml -e "new_img=lyvanna544/${FULL_IMG}"
                    """
                }
            }
        } 
    }
}